    );
    if k = 0 then
        vert := [1];
        adj := [[1], [241]];
        illegalc := [[1], [131], [241]];
    elif k = 1 then
        vert := [1, 241];
        adj := [[1, 131], [1, 241]];
        illegalc := [vert];
    elif k = 2 then
        vert := [1, 131, 241];
        adj := [[1, 25, 241], [1, 131, 241]];
        illegalc := [vert];
    else
        Error("invalid parameters");
    fi;
    PolyDiminish(G, vert, adj, illegalc);
end;

ToCoords := function(n, vert, gens)
    local toVec;
    toVec := function(i)
        if i <= n then
            return IdentityMat(n)[i];
        else
            return -IdentityMat(n)[i-n];
        fi;
    end;
    return List(Orbit(Group(gens), vert, OnSets), v -> Sum(v, toVec));
end;

