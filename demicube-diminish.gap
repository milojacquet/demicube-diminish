        (327,328)(330,331)(332,333)(335,341)(336,338)(337,342)(340,343)(344,348)(345,350)(351,419)(352,420)(353,479)(354,480)(355,481)(356,482)(359,483)(360,484)(361,485)(362,486)(363,487)(364,488)
        (365,489)(366,490)(367,491)(368,492)(370,493)(371,494)(372,495)(373,496)(374,497)(375,433)(376,434)(377,498)(378,499)(379,500)(381,501)(382,502)(383,503)(384,504)(385,505)(386,506)(387,507)(388,508)(394,509)(396,510)(397,511)
        (398,512)(399,461)(400,513)(401,514)(402,515)(405,516)(406,517)(407,518)(408,465)(409,519)(410,472)(411,476)(412,520)(413,521)(414,522)(415,523)(416,524)(417,525)(418,526)(421,422)(423,427)
        (424,428)(431,432)(435,436)(437,439)(438,440)(445,446)(447,453)(448,454)(449,455)(451,456)(457,458)(459,460)(466,467)(468,469)(471,473)(474,478)(527,562)(528,552)(529,565)(530,561)(531,554)(532,550)(533,547)(534,549)(535,548)
        (536,558)(537,556)(538,563)(539,564)(540,557)(541,551)(542,566)(543,560)(544,555)(545,559)(546,553)(567,593)(569,615)(570,616)(571,617)(572,618)(574,619)(575,620)(576,599)(577,621)(578,622)
